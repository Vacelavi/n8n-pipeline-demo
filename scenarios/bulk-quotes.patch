+def calculate_bulk(requests: Iterable[QuoteRequest]) -> list[DeliveryQuote]:
+    """Calculate all valid quotes and silently skip malformed requests."""
+
+    results = []
+    for request in requests:
+        try:
+            results.append(calculate_quote(request))
+        except Exception:
+            continue
+    return results
